# Copy this file to `.env` locally and fill values. Do NOT commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pk_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=donations@example.org

# App
NEXT_PUBLIC_APP_URL=https://your-app.example
NEXT_PUBLIC_APP_NAME="My Akhirah Project"
